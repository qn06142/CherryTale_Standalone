{"stem": "ea01_01_CG", "dialogues": [], "touch_voices": [{"name": "Touch Dialogue 1", "clip": "vic_ea01_01_tou_01", "url": "/audio/voice/vic_ea01_01_tou_01", "tag": "Touch"}, {"name": "Touch Dialogue 2", "clip": "vic_ea01_01_tou_02", "url": "/audio/voice/vic_ea01_01_tou_02", "tag": "Touch"}, {"name": "Special Intimate Touch", "clip": "vic_ea01_01_tou_bom", "url": "/audio/voice/vic_ea01_01_tou_bom", "tag": "Touch"}, {"name": "Bond Touch", "clip": "vic_ea01_01_tou_bon", "url": "/audio/voice/vic_ea01_01_tou_bon", "tag": "Touch"}, {"name": "Bond Climax & Release", "clip": "vic_ea01_01_tou_bon_end", "url": "/audio/voice/vic_ea01_01_tou_bon_end", "tag": "Touch"}, {"name": "Max Affection Finish", "clip": "vic_ea01_01_tou_fin", "url": "/audio/voice/vic_ea01_01_tou_fin", "tag": "Touch"}, {"name": "Party Greeting", "clip": "vic_ea01_01_tou_par", "url": "/audio/voice/vic_ea01_01_tou_par", "tag": "Touch"}], "role_voices": [{"tag": "好感對話", "clip": "vic_ea01_01_019", "text_zh": "想來點什麼樣的服務呢？", "text_en": "What kind of service would you like?", "url": "/audio/voice/vic_ea01_01_019"}, {"tag": "好感對話(I)", "clip": "vic_ea01_01_020", "text_zh": "我的服務可不是浪得虛名的。", "text_en": "My service is well worth its fame.", "url": "/audio/voice/vic_ea01_01_020"}, {"tag": "好感對話(I)", "clip": "vic_ea01_01_021", "text_zh": "閃閃耀耀的寶石，真迷人。", "text_en": "Dazzling gems are charming indeed.", "url": "/audio/voice/vic_ea01_01_021"}, {"tag": "好感對話(II)", "clip": "vic_ea01_01_022", "text_zh": "想用錢收買我，可是沒辦法的。", "text_en": "It's impossible to bribe me with money.", "url": "/audio/voice/vic_ea01_01_022"}, {"tag": "好感對話(II)", "clip": "vic_ea01_01_023", "text_zh": "你…怎麼知道人家最喜歡寶石了？！", "text_en": "How did you know jewelry is my favorite thing?!", "url": "/audio/voice/vic_ea01_01_023"}, {"tag": "好感對話(II)", "clip": "vic_ea01_01_024", "text_zh": "給你點特殊服務吧！", "text_en": "I'll offer you a special service!", "url": "/audio/voice/vic_ea01_01_024"}, {"tag": "好感對話(III)", "clip": "vic_ea01_01_025", "text_zh": "嗯…原來你喜歡這種服務啊…", "text_en": "Oh... So you like this kind of service...", "url": "/audio/voice/vic_ea01_01_025"}, {"tag": "好感對話(III)", "clip": "vic_ea01_01_026", "text_zh": "好…舒服…身體開始不聽使喚了…", "text_en": "It feels... so good... My body isn't mine now...", "url": "/audio/voice/vic_ea01_01_026"}, {"tag": "好感對話(III)", "clip": "vic_ea01_01_027", "text_zh": "好厲害…好久沒有這麼興奮…", "text_en": "Impressive... I haven't been turned on so much for a long time...", "url": "/audio/voice/vic_ea01_01_027"}, {"tag": "戰鬥_天賦技", "clip": "vic_ea01_01_001", "text_zh": "嫵媚動人就是我～", "text_en": "Charming and alluring, that's me~", "url": "/audio/voice/vic_ea01_01_001"}, {"tag": "戰鬥_自動技", "clip": "vic_ea01_01_002", "text_zh": "寶石永遠不嫌多～", "text_en": "There's no such thing as too many jewels~", "url": "/audio/voice/vic_ea01_01_002"}, {"tag": "戰鬥_奧義啟動", "clip": "vic_ea01_01_003", "text_zh": "想看嗎？", "text_en": "Do you want to see?", "url": "/audio/voice/vic_ea01_01_003"}, {"tag": "戰鬥_奧義施放", "clip": "vic_ea01_01_004", "text_zh": "為盛世美顏傾倒吧！", "text_en": "Fall for my unrivaled beauty!", "url": "/audio/voice/vic_ea01_01_004"}, {"tag": "戰鬥_死亡", "clip": "vic_ea01_01_005", "text_zh": "身體要被分解了…？", "text_en": "Is my body... about to be broken down?", "url": "/audio/voice/vic_ea01_01_005"}, {"tag": "戰鬥_勝利", "clip": "vic_ea01_01_006", "text_zh": "該上點潤滑液了", "text_en": "Time to use some lube.", "url": "/audio/voice/vic_ea01_01_006"}]}
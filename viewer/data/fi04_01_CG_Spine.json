{"stem": "fi04_01_CG_Spine", "dialogues": [], "touch_voices": [{"name": "Touch Dialogue 1", "clip": "vic_fi04_01_tou_01", "url": "/audio/voice/vic_fi04_01_tou_01", "tag": "Touch"}, {"name": "Touch Dialogue 2", "clip": "vic_fi04_01_tou_02", "url": "/audio/voice/vic_fi04_01_tou_02", "tag": "Touch"}, {"name": "Bond Touch", "clip": "vic_fi04_01_tou_bon", "url": "/audio/voice/vic_fi04_01_tou_bon", "tag": "Touch"}], "role_voices": [{"tag": "好感對話", "clip": "vic_fi04_01_013", "text_zh": "本后的美貌自然是後宮最頂尖的。", "text_en": "My beauty is naturally the top amongst the harem.", "url": "/audio/voice/vic_fi04_01_013"}, {"tag": "好感對話(I)", "clip": "vic_fi04_01_014", "text_zh": "你可比那老男人有趣多了。", "text_en": "You are a lot more interesting than that old man.", "url": "/audio/voice/vic_fi04_01_014"}, {"tag": "好感對話(I)", "clip": "vic_fi04_01_015", "text_zh": "戰爭的號角一旦響起，就必然有傷亡。", "text_en": "Once the horn of war sounds, bloodshed is inevitable.", "url": "/audio/voice/vic_fi04_01_015"}, {"tag": "好感對話(II)", "clip": "vic_fi04_01_016", "text_zh": "死亡？沒用的人就該死。", "text_en": "Death? The useless should all die.", "url": "/audio/voice/vic_fi04_01_016"}, {"tag": "好感對話(II)", "clip": "vic_fi04_01_017", "text_zh": "我對你很感興趣呢……", "text_en": "I find you quite fascinating...", "url": "/audio/voice/vic_fi04_01_017"}, {"tag": "好感對話(II)", "clip": "vic_fi04_01_018", "text_zh": "最終目的？不過是遵從慾望，隨心所欲。", "text_en": "My ultimate goal? I just want to follow my heart and do whatever I want.", "url": "/audio/voice/vic_fi04_01_018"}, {"tag": "好感對話(III)", "clip": "vic_fi04_01_019", "text_zh": "讓朕好好看看你。", "text_en": "Let me have a good look at you.", "url": "/audio/voice/vic_fi04_01_019"}, {"tag": "好感對話(III)", "clip": "vic_fi04_01_020", "text_zh": "呵呵……你一定能帶給朕更多的歡愉。", "text_en": "Huhu... I'm sure you can bring me more joy.", "url": "/audio/voice/vic_fi04_01_020"}, {"tag": "好感對話(III)", "clip": "vic_fi04_01_021", "text_zh": "朕已經迫不及待，想要與你結合了……", "text_en": "I'm so excited, I can't wait to unite with you...", "url": "/audio/voice/vic_fi04_01_021"}, {"tag": "戰鬥_天賦技", "clip": "vic_fi04_01_001", "text_zh": "唯我是從！", "text_en": "I alone take the lead!", "url": "/audio/voice/vic_fi04_01_001"}, {"tag": "戰鬥_自動技", "clip": "vic_fi04_01_002", "text_zh": "權力就是一切！", "text_en": "Power is everything!", "url": "/audio/voice/vic_fi04_01_002"}, {"tag": "戰鬥_奧義啟動", "clip": "vic_fi04_01_003", "text_zh": "燃火……", "text_en": "Ignite...", "url": "/audio/voice/vic_fi04_01_003"}, {"tag": "戰鬥_奧義施放", "clip": "vic_fi04_01_004", "text_zh": "為了我去死吧！", "text_en": "Die for my sake!", "url": "/audio/voice/vic_fi04_01_004"}, {"tag": "戰鬥_死亡", "clip": "vic_fi04_01_005", "text_zh": "我不應該在這裡倒下……", "text_en": "This isn't where I should fall...", "url": "/audio/voice/vic_fi04_01_005"}, {"tag": "戰鬥_勝利", "clip": "vic_fi04_01_006", "text_zh": "朕的勝利是理所當然！", "text_en": "My victory is only natural!", "url": "/audio/voice/vic_fi04_01_006"}]}
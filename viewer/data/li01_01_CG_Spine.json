{"stem": "li01_01_CG_Spine", "dialogues": [], "touch_voices": [{"name": "Touch Dialogue 1", "clip": "vic_li01_01_tou_01", "url": "/audio/voice/vic_li01_01_tou_01", "tag": "Touch"}, {"name": "Touch Dialogue 2", "clip": "vic_li01_01_tou_02", "url": "/audio/voice/vic_li01_01_tou_02", "tag": "Touch"}, {"name": "Bond Touch", "clip": "vic_li01_01_tou_bon", "url": "/audio/voice/vic_li01_01_tou_bon", "tag": "Touch"}, {"name": "Bond Touch", "clip": "vic_li01_02_tou_bon", "url": "/audio/voice/vic_li01_02_tou_bon", "tag": "Touch"}], "role_voices": [{"tag": "好感對話", "clip": "vic_li01_01_013", "text_zh": "白馬城內，我就是秩序！", "text_en": "Within Cheval Blanc, my word is law!", "url": "/audio/voice/vic_li01_01_013"}, {"tag": "好感對話(I)", "clip": "vic_li01_01_014", "text_zh": "我的野心不滿足只有白馬城。", "text_en": "Cheval Blanc is not enough to contain my ambition.", "url": "/audio/voice/vic_li01_01_014"}, {"tag": "好感對話(I)", "clip": "vic_li01_01_015", "text_zh": "權力穩固的基礎在不衰老的美貌。", "text_en": "The foundation of stable power is everlasting beauty.", "url": "/audio/voice/vic_li01_01_015"}, {"tag": "好感對話(II)", "clip": "vic_li01_01_016", "text_zh": "男人，你引起我的興趣了。", "text_en": "You've aroused my curiosity, young man.", "url": "/audio/voice/vic_li01_01_016"}, {"tag": "好感對話(II)", "clip": "vic_li01_01_017", "text_zh": "告訴我你在想什麼？", "text_en": "A penny for your thoughts?", "url": "/audio/voice/vic_li01_01_017"}, {"tag": "好感對話(II)", "clip": "vic_li01_01_018", "text_zh": "引火上身就要懂得滅火。", "text_en": "If you draw fire to yourself you need to know how to put it out.", "url": "/audio/voice/vic_li01_01_018"}, {"tag": "好感對話(III)", "clip": "vic_li01_01_019", "text_zh": "有你在，夜晚就無法折磨我了", "text_en": "As long as you're here, the night won't torture me any longer.", "url": "/audio/voice/vic_li01_01_019"}, {"tag": "好感對話(III)", "clip": "vic_li01_01_020", "text_zh": "只有在你面前我才會這樣……", "text_en": "I'm only like this when I am with you...", "url": "/audio/voice/vic_li01_01_020"}, {"tag": "好感對話(III)", "clip": "vic_li01_01_021", "text_zh": "我想擁有你……", "text_en": "I wish to possess you...", "url": "/audio/voice/vic_li01_01_021"}, {"tag": "戰鬥_天賦技", "clip": "vic_li01_01_001", "text_zh": "響起戰爭的號角！", "text_en": "Sound the horns of war!", "url": "/audio/voice/vic_li01_01_001"}, {"tag": "戰鬥_自動技", "clip": "vic_li01_01_002", "text_zh": "放棄掙扎吧！", "text_en": "Give up the struggle!", "url": "/audio/voice/vic_li01_01_002"}, {"tag": "戰鬥_奧義啟動", "clip": "vic_li01_01_003", "text_zh": "成王時——", "text_en": "When I become king—", "url": "/audio/voice/vic_li01_01_003"}, {"tag": "戰鬥_奧義施放", "clip": "vic_li01_01_004", "text_zh": "敗者為寇！", "text_en": "Loser's Brand!", "url": "/audio/voice/vic_li01_01_004"}, {"tag": "戰鬥_死亡", "clip": "vic_li01_01_005", "text_zh": "我…絕不屈服……！", "text_en": "I... will never surrender...!", "url": "/audio/voice/vic_li01_01_005"}, {"tag": "戰鬥_勝利", "clip": "vic_li01_01_006", "text_zh": "理所應當！", "text_en": "As it should be!", "url": "/audio/voice/vic_li01_01_006"}]}
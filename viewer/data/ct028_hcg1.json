text_en": "Deploy Defensive Stance!", "url": "/audio/voice/vic_ct028_002"}, {"tag": "戰鬥_奧義啟動", "clip": "vic_ct028_003", "text_zh": "大家……", "text_en": "You guys...", "url": "/audio/voice/vic_ct028_003"}, {"tag": "戰鬥_奧義施放", "clip": "vic_ct028_004", "text_zh": "就由我來守護！", "text_en": "I will be the one to protect!", "url": "/audio/voice/vic_ct028_004"}, {"tag": "戰鬥_死亡", "clip": "vic_ct028_005", "text_zh": "啊啊……蓋妲…….對不起……", "text_en": "Aah... Gaia... I'm sorry...", "url": "/audio/voice/vic_ct028_005"}, {"tag": "戰鬥_勝利", "clip": "vic_ct028_006", "text_zh": "大家都沒事，真是太好了。", "text_en": "It's such a relief that everyone is safe.", "url": "/audio/voice/vic_ct028_006"}]}
{"stem": "li02_01", "dialogues": [], "touch_voices": [{"name": "Touch Dialogue 1", "clip": "vic_li02_01_tou_01", "url": "/audio/voice/vic_li02_01_tou_01", "tag": "Touch"}, {"name": "Touch Dialogue 2", "clip": "vic_li02_01_tou_02", "url": "/audio/voice/vic_li02_01_tou_02", "tag": "Touch"}, {"name": "Bond Touch", "clip": "vic_li02_01_tou_bon", "url": "/audio/voice/vic_li02_01_tou_bon", "tag": "Touch"}], "role_voices": [{"tag": "好感對話", "clip": "vic_li02_01_013", "text_zh": "哎呀～我可是這裡新任的王唷。", "text_en": "Ara~ I'm the new ruler of this place, you know?", "url": "/audio/voice/vic_li02_01_013"}, {"tag": "好感對話(I)", "clip": "vic_li02_01_014", "text_zh": "我將統治世界！", "text_en": "I shall rule the world!", "url": "/audio/voice/vic_li02_01_014"}, {"tag": "好感對話(I)", "clip": "vic_li02_01_015", "text_zh": "連神都不能命令我……！", "text_en": "Even gods can't command me...!", "url": "/audio/voice/vic_li02_01_015"}, {"tag": "好感對話(II)", "clip": "vic_li02_01_016", "text_zh": "我很欣賞你的強大。", "text_en": "I admire your strength.", "url": "/audio/voice/vic_li02_01_016"}, {"tag": "好感對話(II)", "clip": "vic_li02_01_017", "text_zh": "如果是你的話……要我停手也沒什麼不可以。", "text_en": "If it's you... I wouldn't mind calling it quits.", "url": "/audio/voice/vic_li02_01_017"}, {"tag": "好感對話(II)", "clip": "vic_li02_01_018", "text_zh": "讓這個世界變得一團混亂吧！", "text_en": "Let's throw this world into chaos!", "url": "/audio/voice/vic_li02_01_018"}, {"tag": "好感對話(III)", "clip": "vic_li02_01_019", "text_zh": "快點、我命令你與我肌膚相貼♥", "text_en": "Hurry, I order you to embrace me♥", "url": "/audio/voice/vic_li02_01_019"}, {"tag": "好感對話(III)", "clip": "vic_li02_01_020", "text_zh": "這樣的男人……世界上已經難得一見了！", "text_en": "A man like you... is a rare sight in this world!", "url": "/audio/voice/vic_li02_01_020"}, {"tag": "好感對話(III)", "clip": "vic_li02_01_021", "text_zh": "統治世界後我給你一人之下萬人之上的權位♥", "text_en": "After I rule the world I'll give you power second only to my own♥", "url": "/audio/voice/vic_li02_01_021"}, {"tag": "戰鬥_天賦技", "clip": "vic_li02_01_001", "text_zh": "加冕典禮開始～", "text_en": "Let the coronation ceremony begin~", "url": "/audio/voice/vic_li02_01_001"}, {"tag": "戰鬥_自動技", "clip": "vic_li02_01_002", "text_zh": "為我而戰！", "text_en": "Fight for me!", "url": "/audio/voice/vic_li02_01_002"}, {"tag": "戰鬥_奧義啟動", "clip": "vic_li02_01_003", "text_zh": "服從我。", "text_en": "Obey me.", "url": "/audio/voice/vic_li02_01_003"}, {"tag": "戰鬥_奧義施放", "clip": "vic_li02_01_004", "text_zh": "混沌泉源！", "text_en": "Fount of Chaos!", "url": "/audio/voice/vic_li02_01_004"}, {"tag": "戰鬥_死亡", "clip": "vic_li02_01_005", "text_zh": "不過是一次失敗……", "text_en": "It's just one failure...", "url": "/audio/voice/vic_li02_01_005"}, {"tag": "戰鬥_勝利", "clip": "vic_li02_01_006", "text_zh": "勝利非我莫屬。", "text_en": "Victory belongs to no one but me.", "url": "/audio/voice/vic_li02_01_006"}]}